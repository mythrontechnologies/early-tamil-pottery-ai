{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "early-tamil-pottery-ai/synthetic_record.schema.json",
  "title": "Synthetic engineering record (Milestone 9) - SYNTHETIC, NOT ARCHAEOLOGICAL EVIDENCE",
  "description": "One generated image of one synthetic object. Separate from image_record.schema.json on purpose: a synthetic record can never validate as a research record, and a research record can never validate as a synthetic one. Archaeological fields are fixed sentinels: synthetic images have no site, context, period, date, transcription or translation.",
  "schema_version": "synthetic-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_type", "synthetic_marker", "label_warning", "image_id", "artifact_id",
    "catalogue_number", "image_path", "image_sha256", "image_width_px", "image_height_px", "view", "source",
    "synthetic_generator_version", "generation_seed", "artifact_index", "view_index", "site", "context",
    "period", "dating_basis", "script_type", "inscription_present", "inscription_type", "transcription",
    "translation", "label_source", "label_confidence", "synthetic_surface", "synthetic_uncertain_mode",
    "synthetic_glyph_sequence", "synthetic_regions", "generation_params_sha256"
  ],
  "properties": {
    "schema_version": {"const": "synthetic-1.0.0"},
    "dataset_type": {"const": "synthetic"},
    "synthetic_marker": {"const": "SYNTHETIC — NOT ARCHAEOLOGICAL EVIDENCE"},
    "label_warning": {"const": "Synthetic task label — not archaeological evidence."},
    "image_id": {"type": "string", "pattern": "^SYNTH-A[0-9]{4,}-V[0-9]+$"},
    "artifact_id": {"type": "string", "pattern": "^SYNTH-A[0-9]{4,}$"},
    "catalogue_number": {"type": "string", "pattern": "^SYNTH-ONLY-[0-9]{4,}$",
                         "description": "A synthetic-only identifier. Not a museum or excavation number."},
    "image_path": {"type": "string", "pattern": "^images/SYNTH-A[0-9]{4,}-V[0-9]+\\.jpg$"},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_width_px": {"type": "integer", "minimum": 1},
    "image_height_px": {"type": "integer", "minimum": 1},
    "view": {"type": "string", "pattern": "^synthetic_view_[0-9]+$"},
    "source": {"const": "synthetic_generator"},
    "synthetic_generator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generation_seed": {"type": "integer"},
    "artifact_index": {"type": "integer", "minimum": 0},
    "view_index": {"type": "integer", "minimum": 0},
    "site": {"const": "not_applicable"},
    "context": {"const": "not_applicable"},
    "period": {"const": "not_applicable"},
    "dating_basis": {"const": "not_applicable"},
    "script_type": {"enum": ["synthetic_tamil_brahmi_like", "synthetic_graffiti_like", "synthetic_none", "synthetic_uncertain"],
                    "description": "SYNTHETIC VISUAL TASK CATEGORY only. Never verified Tamil-Brahmi or verified graffiti."},
    "inscription_present": {"enum": ["yes", "no", "uncertain"],
                            "description": "Whether the generator drew deliberate marks: yes, no, or uncertain (drawn but degraded below legibility). Never 'unknown': the generator always knows."},
    "inscription_type": {"enum": ["synthetic_glyph_row", "synthetic_isolated_marks", "synthetic_degraded_marks", "not_applicable"]},
    "transcription": {"const": "not_applicable", "description": "Synthetic marks have no language; see synthetic_glyph_sequence for the benchmark tokens."},
    "translation": {"const": "not_applicable"},
    "label_source": {"const": "synthetic_ground_truth"},
    "label_confidence": {"const": "high", "description": "Certainty that the generator drew this category; not archaeological confidence."},
    "synthetic_surface": {"enum": ["reddish", "buff", "grey", "dark", "two_tone"]},
    "synthetic_uncertain_mode": {"enum": ["cut_row", "faint", "fragment", "overscratched", "not_applicable"]},
    "synthetic_glyph_sequence": {
      "type": "array", "maxItems": 2,
      "description": "Words of synthetic glyph codes (SG00-SG15), left to right. Benchmark tokens only: no sound, reading or meaning.",
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SG[0-9]{2}$"}}
    },
    "synthetic_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "token", "x", "y", "width", "height", "quad", "visible_fraction"],
        "properties": {
          "kind": {"enum": ["glyph_row", "glyph", "mark"]},
          "token": {"type": "string"},
          "glyph_index": {"type": "integer", "minimum": 0},
          "word_index": {"type": "integer", "minimum": 0},
          "x": {"type": "number", "minimum": 0, "maximum": 1},
          "y": {"type": "number", "minimum": 0, "maximum": 1},
          "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "quad": {"type": "array", "minItems": 4, "maxItems": 4,
                   "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
          "visible_fraction": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "generation_params_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
